% Styling
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% One bullet glyph at every list level: nested dashes read as prose, not list items.
\renewcommand{\labelitemi}{\textbullet}
\renewcommand{\labelitemii}{\textbullet}
\setlist{noitemsep, topsep=2pt, partopsep=0pt}

% Quotes
\usepackage[autostyle,english=american]{csquotes}
\MakeOuterQuote{"}

% Define colors
\definecolor{color-text}{gray}{0.10}    % light black
\definecolor{color-detail}{gray}{0.40}  % dark gray
\colorlet{color-title}{\theme}          % black

% Hyperlinks
\newcommand{\link}[2]{\href{#1}{\underline{\smash{#2}}}}

% Set text color
\makeatletter
\newcommand{\globalcolor}[1]{\color{#1}\global\let\default@color\current@color}
\makeatother
\AtBeginDocument{\globalcolor{color-text}}

% Shorthand: the visible text is the full address, so parsers resolve it without the icon
\newcommand{\github}[1]{\href{https://github.com/#1/}{github.com/#1}}
\newcommand{\email}[1]{\href{mailto:#1}{#1}}
\newcommand{\website}[1]{\href{https://#1/}{#1}}
\newcommand{\linkedin}[1]{\href{https://www.linkedin.com/in/#1/}{linkedin.com/in/#1}}

% Simple heading: name + comma-separated contact items
\makeatletter
\newcommand{\headingsimple}[2]{%
  \begin{center}
    {\HUGE \textcolor{color-title}{#1}}\\[\bigskipamount]
    \def\simplecv@sep{}%
    \forcsvlist{\simplecv@contact}{#2}%
  \end{center}
}
% Items are kept whole and separated by glue only, so a wrapped contact line
% never starts or ends with a stray separator glyph.
\newcommand{\simplecv@contact}[1]{%
  \simplecv@sep \mbox{#1}%
  \def\simplecv@sep{\hspace{12pt}}%
}
\makeatother

% Heading: [job title]{name}{comma-separated contact items}
% Everything stacks in one column so extraction order is name, title, then
% addresses. Wrap a contact item that contains a comma in braces.
\makeatletter
\newcommand{\headinginline}[3][]{%
  \begingroup
  \noindent{\HUGE \textcolor{color-title}{#2}}\par
  \ifstrempty{#1}{\vspace{2pt}}{%
    \vspace{2pt}\noindent{\large \textcolor{color-detail}{#1}}\par\vspace{3pt}}%
  \noindent\def\simplecv@sep{}{\small \forcsvlist{\simplecv@contact}{#3}}\par
  \vspace{5pt}
  \noindent\textcolor{color-title}{\rule{\linewidth}{1pt}}
  \endgroup
}
\makeatother

% Two-columns
\newcommand{\sidebyside}[2]{
  \begin{multicols}{2}
    #1 \columnbreak
    #2
  \end{multicols}
}

% Section titles
\titleformat{\section}{%
  \raggedright\Large\bfseries\color{color-title}\addfontfeatures{LetterSpace=4}}{}{0em}{}
[\color{color-title}\titlerule\vspace{-\smallskipamount}]
\titlespacing*{\section}{0pt}{10pt}{5pt}

% Subsection titles
\titleformat{\subsection}{%
  \raggedright\large\color{color-title}}{}{0em}{}[\vspace{-\smallskipamount}]
\titlespacing*{\subsection}{0pt}{6pt}{3pt}

% Footer
\fancyfoot[R]{Page \thepage \hspace{1pt} of \pageref{LastPage}}

% Lists
\newcommand{\outerlist}[1]{
  \begin{itemize}[leftmargin=*] #1
\end{itemize}}
\newcommand{\denseouterlist}[1]{
  \begin{itemize}[leftmargin=*,itemsep=0pt] #1
\end{itemize}}
\newcommand{\innerlist}[1]{
  \begin{itemize}[topsep=0pt] #1
\end{itemize}}
\newcommand{\orderedouterlist}[1]{
  \begin{enumerate}[leftmargin=*] #1
\end{enumerate}}
\newcommand{\denseorderedouterlist}[1]{
  \begin{enumerate}[leftmargin=*,itemsep=0pt] #1
\end{enumerate}}

% List items
\newcommand{\entry}[1]{
\item\small{#1}}  % bullet / body line
\newcommand{\entryextra}[1]{\textcolor{color-detail}{\entry{#1}}}  % muted secondary bullet
\newcommand{\entrylabeled}[2][]{
\item[#1]\small{#2}}  % bullet with a custom label

\newcommand{\entrymid}[4][]{  % title + date, italic subtitle (teaching, volunteering)
\item[#1] \small{#2} \hfill \small{#3}%
  \ifstrempty{#4}{}{%
    \vspace{-\smallskipamount}%
    \item[]\small{\textit{#4}}}}

\newcommand{\entrybig}[5][]{
\needspace{5\baselineskip}  % an entry that starts a page should finish on it
\item[#1]  % org + location, role + dates (jobs, education)
  \begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}r@{}}
    {\normalsize\bfseries #2} & {\small\textcolor{color-detail}{#3}} \\
    {\small #4} & {\small\textcolor{color-detail}{#5}} \\
\end{tabular*}}

\newcommand{\entryrole}[2]{% extra role + dates under the same \entrybig (promotions)
  \par\nobreak\vspace{-\parskip}\nointerlineskip
  \begin{tabular*}{\linewidth}{l@{\extracolsep{\fill}}r}
    {\small#1} & {\small #2} \\
\end{tabular*}}

\newcommand{\entrybigonecol}[3][]{
\item[#1]  % two left-only rows (projects without location/dates)
  \begin{tabular*}{\linewidth}{l@{\extracolsep{\fill}}r}
    #2 & \\ {\small#3} & \\
\end{tabular*}}

\makeatletter
\newcommand{\entryrule}{% theme-colored divider, centered between two \entrybig items
  % If we're inside a list (\@listdepth>0) emit an empty \item[] so the
  % rule lines up with other items; otherwise just emit a standalone rule.
  \ifnum\@listdepth>0
\item[]% empty list item to position the rule
  \par\nobreak\nointerlineskip\vspace*{\smallskipamount}
  \noindent\textcolor{color-title}{\rule{\linewidth}{0.1pt}}%
  \par\nobreak\nointerlineskip\vspace*{\smallskipamount}
  \else
  \par\nobreak\nointerlineskip\vspace*{\smallskipamount}
  \noindent\textcolor{color-title}{\rule{\linewidth}{0.1pt}}%
  \par\nobreak\nointerlineskip\vspace*{\smallskipamount}
\fi}
\makeatother
